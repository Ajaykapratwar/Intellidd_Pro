# ─── LLM Providers ────────────────────────────────────────────
# PRIMARY: Groq - Free at https://console.groq.com (no credit card)
GROQ_API_KEY=your_groq_api_key_here

# FALLBACK: Google Gemini - Free at https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# ─── Web Scraping ─────────────────────────────────────────────
# Firecrawl - Free tier: 500 scrapes/month at https://firecrawl.dev
# Leave empty to skip Firecrawl and use Playwright+BS4 directly
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ─── Observability ────────────────────────────────────────────
# LangSmith - Free tier: 5,000 traces/month at https://smith.langchain.com
# Set LANGCHAIN_TRACING_V2=true to enable tracing
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=intellidd-pro
LANGCHAIN_TRACING_V2=false

# ─── Alerting (Phase 7 - optional) ───────────────────────────
ALERT_EMAIL_FROM=your_gmail@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── App Config ───────────────────────────────────────────────
DB_PATH=./intellidd.db
CHROMA_PATH=./chroma_store
MAX_WORKERS=7
AGENT_TIMEOUT_SECONDS=90